@model Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="row justify-content-center">
    <div class="col-md-8">

        <h1 class="mb-4 text-danger">Delete Student</h1>

        <div class="alert alert-warning">
            Are you sure you want to delete this student?
        </div>

        <dl class="row">

            <dt class="col-sm-3">
                Full Name
            </dt>

            <dd class="col-sm-9">
                @Model.FullName
            </dd>


            <dt class="col-sm-3">
                Email
            </dt>

            <dd class="col-sm-9">
                @Model.Email
            </dd>


            <dt class="col-sm-3">
                Age
            </dt>

            <dd class="col-sm-9">
                @Model.Age
            </dd>

            <dt class="col-sm-3">
                Major
            </dt>

            <dd class="col-sm-9">
                @Model.Major
            </dd>

        </dl>

        <form asp-action="DeleteConfirm" method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit" class="btn btn-danger">
                Delete
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>
